        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <div>
            <div style="font-size:16px;font-weight:500" id="sr-nama"></div>
            <div style="font-size:12px;color:#6b7280" id="sr-polisi"></div>
          </div>
          <button class="btn" style="width:auto;padding:6px 12px;font-size:12px" onclick="logoutSaldo()">Keluar</button>
        </div>
        <div class="stat-grid">
          <div class="stat-card"><div class="lbl">Total Tabungan</div><div class="val" id="sr-saldo" style="color:#1d4ed8">Rp 0</div></div>
          <div class="stat-card"><div class="lbl">Target</div><div class="val" id="sr-target">Rp 0</div></div>
        </div>
