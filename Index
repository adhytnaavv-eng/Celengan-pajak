<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Celengan Pajak</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Arial,sans-serif;
  font-size:14px;
  color:#1f2937;
  background:#f5f7fb;
  line-height:1.5
}

.app{
  min-height:100vh;
  max-width:1200px;
  margin:auto;
  background:#f5f7fb
}

.nav{
  display:flex;
  gap:8px;
  padding:12px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  position:sticky;
  top:0;
  z-index:50
}

.nav-btn{
  flex:1;
  padding:12px 10px;
  background:#f9fafb;
  border:none;
  border-radius:10px;
  cursor:pointer;
  font-size:13px;
  font-weight:600;
  color:#6b7280;
  transition:.2s
}

.nav-btn.active{
  background:#111827;
  color:#fff
}

.nav-btn:hover{
  background:#e5e7eb
}

.page{
  display:none;
  padding:18px
}

.page.active{
  display:block
}

.card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:18px;
  margin-bottom:16px;
  box-shadow:0 2px 10px rgba(0,0,0,.04)
}

.card-title{
  font-size:16px;
  font-weight:700;
  margin-bottom:16px;
  display:flex;
  align-items:center;
  gap:8px
}

.field{
  margin-bottom:14px
}

.field label{
  display:block;
  font-size:12px;
  font-weight:600;
  color:#6b7280;
  margin-bottom:6px
}

.field input{
  width:100%;
  padding:11px 12px;
  border:1px solid #d1d5db;
  border-radius:10px;
  background:#fff;
  font-size:14px;
  transition:.2s
}

.field input:focus{
  outline:none;
  border-color:#111827;
  box-shadow:0 0 0 3px rgba(17,24,39,.08)
}

.row2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px
}

.btn{
  width:100%;
  padding:11px;
  border:none;
  border-radius:10px;
  font-size:14px;
  font-weight:600;
  cursor:pointer;
  transition:.2s
}

.btn:hover{
  opacity:.92
}

.btn:active{
  transform:scale(.98)
}

.btn-primary{
  background:#111827;
  color:#fff
}

.btn-success{
  background:#16a34a;
  color:#fff
}

.btn-danger{
  background:#dc2626;
  color:#fff
}

.btn:disabled{
  opacity:.5;
  cursor:not-allowed
}

.notice{
  padding:11px 12px;
  border-radius:10px;
  font-size:12px;
  margin-top:10px
}

.notice-info{
  background:#dbeafe;
  color:#1d4ed8
}

.notice-success{
  background:#dcfce7;
  color:#166534
}

.notice-warn{
  background:#fef3c7;
  color:#92400e
}

.notice-danger{
  background:#fee2e2;
  color:#991b1b
}

.popup-wrap{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  z-index:99;
  align-items:center;
  justify-content:center;
  padding:16px;
  overflow-y:auto
}

.popup-wrap.open{
  display:flex
}

.popup{
  background:#fff;
  border-radius:16px;
  padding:22px;
  max-width:400px;
  width:100%;
  box-shadow:0 10px 30px rgba(0,0,0,.15);
  max-height:90vh;
  overflow-y:auto
}

.popup h3{
  font-size:17px;
  font-weight:700;
  margin-bottom:14px
}

.sim-row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:8px 0;
  border-bottom:1px solid #f1f5f9;
  font-size:13px
}

.highlight{
  color:#2563eb;
  font-size:18px;
  font-weight:700
}

.prog-bar{
  height:10px;
  border-radius:999px;
  background:#e5e7eb;
  overflow:hidden;
  margin:10px 0
}

.prog-fill{
  height:100%;
  background:#ef4444;
  border-radius:999px;
  transition:.4s
}

.prog-fill.done{
  background:#16a34a
}

.tbl{
  width:100%;
  border-collapse:collapse;
  font-size:12px
}

.tbl th{
  text-align:left;
  padding:10px 8px;
  background:#f9fafb;
  color:#6b7280;
  font-weight:600
}

.tbl td{
  padding:10px 8px;
  border-bottom:1px solid #f1f5f9
}

.badge{
  display:inline-block;
  padding:4px 10px;
  border-radius:999px;
  font-size:11px;
  font-weight:600
}

.badge-success{
  background:#dcfce7;
  color:#166534
}

.badge-warn{
  background:#fef3c7;
  color:#92400e
}

.badge-info{
  background:#dbeafe;
  color:#1d4ed8
}

.stat-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-bottom:14px
}

.stat-card{
  background:#f9fafb;
  border-radius:12px;
  padding:14px
}

.stat-card .lbl{
  font-size:11px;
  color:#6b7280;
  margin-bottom:4px
}

.stat-card .val{
  font-size:18px;
  font-weight:700
}

.photo-area{
  border:1px dashed #cbd5e1;
  border-radius:12px;
  padding:18px;
  text-align:center;
  cursor:pointer;
  margin-bottom:10px;
  color:#6b7280;
  font-size:12px;
  background:#fafafa
}

.photo-preview{
  max-width:100%;
  border-radius:10px;
  margin-top:10px;
  display:none
}

.sect-tabs{
  display:flex;
  gap:8px;
  margin-bottom:16px;
  flex-wrap:wrap
}

.sect-tab{
  padding:8px 14px;
  border-radius:999px;
  border:none;
  background:#fff;
  font-size:12px;
  cursor:pointer;
  color:#6b7280;
  font-weight:600;
  box-shadow:0 1px 3px rgba(0,0,0,.05)
}

.sect-tab.active{
  background:#111827;
  color:#fff
}

.admin-section{
  display:none
}

.admin-section.active{
  display:block
}

.green-name{
  color:#16a34a;
  font-weight:700
}

.red-target{
  color:#dc2626;
  font-weight:700
}

.check-btn{
  width:32px;
  height:32px;
  border-radius:10px;
  border:none;
  background:#f3f4f6;
  cursor:pointer;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  font-size:14px;
  color:#374151
}

.check-btn:hover{
  background:#dcfce7;
  color:#166534
}

.qr-container {
  text-align: center;
  margin: 15px 0;
  padding: 12px;
  background: #f8fafc;
  border-radius: 12px;
  border: 1px dashed #e2e8f0;
}

.qr-image {
  width: 180px;
  height: 180px;
  margin: 8px auto;
  display: block;
}

@media(max-width:768px){
  .page{ padding:14px }
  .row2{ grid-template-columns:1fr }
  .stat-grid{ grid-template-columns:1fr }
  .tbl{ min-width:600px }
  .nav{ padding:10px }
  .nav-btn{ font-size:12px; padding:11px 6px }
  .card{ padding:16px }
}
</style>
</head>
<body>

<div class="app" style="position:relative">

<div class="nav">
  <button class="nav-btn active" onclick="showMain('user')"><i class="ti ti-user" aria-hidden="true"></i> Form User</button>
  <button class="nav-btn" onclick="showMain('admin')"><i class="ti ti-shield" aria-hidden="true"></i> Form Admin</button>
</div>

<div id="pg-user" class="page active">
  <div class="sect-tabs">
    <button class="sect-tab active" onclick="showUserSect('register')"><i class="ti ti-user-plus" aria-hidden="true"></i> Register</button>
    <button class="sect-tab" onclick="showUserSect('setor')"><i class="ti ti-cash" aria-hidden="true"></i> Setor</button>
    <button class="sect-tab" onclick="showUserSect('saldo')"><i class="ti ti-chart-bar" aria-hidden="true"></i> Cek Saldo &amp; Klaim</button>
  </div>

  <div id="us-register" class="admin-section active">
    <div class="card">
      <div class="card-title"><i class="ti ti-user-plus" aria-hidden="true"></i> Daftar Akun Baru</div>
      <div class="field"><label>Nama lengkap (sesuai KTP)</label><input id="r-nama" type="text" placeholder="Contoh: Budi Santoso"></div>
      <div class="row2">
        <div class="field"><label>No. WhatsApp</label><input id="r-wa" type="tel" placeholder="08xxxxxxxxxx"></div>
        <div class="field"><label>No. Polisi Kendaraan</label><input id="r-polisi" type="text" placeholder="B 1234 ABC" style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()"></div>
      </div>
      <div class="row2">
        <div class="field"><label>Password</label><input id="r-pass" type="password" placeholder="Min. 6 karakter"></div>
        <div class="field"><label>Konfirmasi Password</label><input id="r-pass2" type="password" placeholder="Ulangi password"></div>
      </div>
      <div class="row2">
        <div class="field"><label>Pajak tahun lalu (Rp)</label><input id="r-pajak" type="number" placeholder="Contoh: 500000" oninput="calcSim()"></div>
        <div class="field"><label>Tanggal jatuh tempo</label><input id="r-tempo" type="date" oninput="calcSim()"></div>
      </div>

      <div id="sim-preview" style="display:none">
        <div style="border-top:0.5px solid #e5e7eb;margin:12px 0;padding-top:12px">
          <div style="font-size:12px;color:#6b7280;margin-bottom:8px">Simulasi tabungan (dihitung otomatis)</div>
          <div class="stat-grid">
            <div class="stat-card"><div class="lbl">Target tabungan</div><div class="val" id="sim-target" style="font-size:15px;color:#dc2626">Rp 0</div></div>
            <div class="stat-card"><div class="lbl">Setoran per minggu</div><div class="val" id="sim-mingguan" style="font-size:15px;color:#1d4ed8">Rp 0</div></div>
          </div>
          <div style="font-size:11px;color:#9ca3af">Pajak lalu + 7% biaya layanan, dibulatkan ke ratusan terdekat ke atas. Sisa <span id="sim-weeks">0</span> minggu menuju jatuh tempo.</div>
        </div>
      </div>

      <div id="r-notice"></div>
      <button class="btn btn-primary" style="margin-top:12px" onclick="doRegister()">Daftar Sekarang</button>
    </div>
  </div>

  <div id="us-setor" class="admin-section">
    <div class="card">
      <div class="card-title"><i class="ti ti-cash" aria-hidden="true"></i> Setor Tabungan</div>
      <div class="row2">
        <div class="field"><label>No. Polisi Kendaraan</label><input id="s-polisi" type="text" placeholder="B 1234 ABC" style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()"></div>
        <div class="field"><label>Nominal Setoran (Rp)</label><input id="s-nominal" type="number" placeholder="Masukkan jumlah"></div>
      </div>
      <div class="field">
        <label>Foto Bukti Transfer</label>
        <div class="photo-area" onclick="document.getElementById('s-foto').click()">
          <i class="ti ti-camera" style="font-size:24px" aria-hidden="true"></i>
          <div style="margin-top:4px">Tap untuk ambil/pilih foto bukti</div>
          <img id="foto-preview" class="photo-preview">
        </div>
        <input type="file" id="s-foto" accept="image/*" capture="environment" style="display:none" onchange="showPhoto(this)">
      </div>
      <div id="s-notice"></div>
      <button class="btn btn-primary" onclick="checkAndPreviewSetor()">Kirim Setoran</button>
    </div>
  </div>

  <div id="us-saldo" class="admin-section">
    <div class="card" id="saldo-login-card">
      <div class="card-title"><i class="ti ti-lock" aria-hidden="true"></i> Masuk untuk Cek Saldo</div>
      <div class="row2">
        <div class="field"><label>No. Polisi Kendaraan</label><input id="cs-polisi" type="text" placeholder="B 1234 ABC" style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()"></div>
        <div class="field"><label>Password</label><input id="cs-pass" type="password" placeholder="Password Anda"></div>
      </div>
      <div id="cs-notice"></div>
      <button class="btn btn-primary" style="margin-top:8px" onclick="doLogin()">Lihat Saldo</button>
    </div>
    <div id="saldo-result" style="display:none">
