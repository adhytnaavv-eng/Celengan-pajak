</div>

<div class="popup-wrap" id="popup">
  <div class="popup">
    <h3 id="popup-title"></h3>
    <div id="popup-content"></div>
    <div style="display:flex;gap:8px;margin-top:14px" id="popup-actions">
      </div>
  </div>
</div>

</div>

<script>
const DB = {
  get users(){ try{return JSON.parse(localStorage.getItem('cpj_users')||'[]')}catch{return[]} },
  set users(v){ localStorage.setItem('cpj_users',JSON.stringify(v)) },
  get setoran(){ try{return JSON.parse(localStorage.getItem('cpj_setoran')||'[]')}catch{return[]} },
  set setoran(v){ localStorage.setItem('cpj_setoran',JSON.stringify(v)) },
  get klaim(){ try{return JSON.parse(localStorage.getItem('cpj_klaim')||'[]')}catch{return[]} },
  set klaim(v){ localStorage.setItem('cpj_klaim',JSON.stringify(v)) },
};

async function sha256(str){
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}

function fmt(n){ return 'Rp '+Math.round(n).toLocaleString('id-ID'); }
function roundUp100(n){ return Math.ceil(n/100)*100; }

function weeksUntil(dateStr){
  if(!dateStr) return 0;
  const diff = new Date(dateStr) - new Date();
  return Math.max(1, Math.ceil(diff/(7*24*3600*1000)));
}

function calcTarget(pajak){
  const raw = pajak * 1.07;
  return roundUp100(raw);
}

function notice(id, msg, type='info'){
  const el = document.getElementById(id);
  if(!el) return;
  el.innerHTML = msg ? `<div class="notice notice-${type}" style="margin-top:8px">${msg}</div>` : '';
}

function showMain(tab){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('pg-'+tab).classList.add('active');
  event.currentTarget.classList.add('active');
}

function showUserSect(sec){
  document.querySelectorAll('#pg-user .admin-section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('#pg-user .sect-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById('us-'+sec).classList.add('active');
  event.currentTarget.classList.add('active');
  if(sec==='saldo'){document.getElementById('saldo-result').style.display='none';document.getElementById('saldo-login-card').style.display='block';}
}

function showAdminSect(sec){
  document.querySelectorAll('#admin-panel .admin-section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('#admin-panel .sect-tab').forEach(b=>b.classList.remove('active'));
  document.getElementById('ad-'+sec).classList.add('active');
  event.currentTarget.classList.add('active');
  if(sec==='data-user') renderAdminUsers();
  if(sec==='konfirmasi-setor') renderAdminSetor();
  if(sec==='konfirmasi-klaim') renderAdminKlaim();
}

function calcSim(){
  const pajak = parseFloat(document.getElementById('r-pajak').value)||0;
  const tempo = document.getElementById('r-tempo').value;
  const preview = document.getElementById('sim-preview');
  if(!pajak||!tempo){preview.style.display='none';return;}
  const target = calcTarget(pajak);
  const weeks = weeksUntil(tempo);
  const perWeek = Math.ceil(target/weeks/100)*100;
  document.getElementById('sim-target').textContent = fmt(target);
  document.getElementById('sim-mingguan').textContent = fmt(perWeek);
  document.getElementById('sim-weeks').textContent = weeks;
  preview.style.display='block';
}

let pendingRegData = null;
let pendingSetorData = null;

async function doRegister(){
  const nama = document.getElementById('r-nama').value.trim();
  const wa = document.getElementById('r-wa').value.trim();
  const polisi = document.getElementById('r-polisi').value.trim().toUpperCase();
  const pass = document.getElementById('r-pass').value;
  const pass2 = document.getElementById('r-pass2').value;
  const pajak = parseFloat(document.getElementById('r-pajak').value)||0;
  const tempo = document.getElementById('r-tempo').value;

  if(!nama||!wa||!polisi||!pass||!pajak||!tempo){notice('r-notice','Semua kolom wajib diisi.','danger');return;}
  if(pass.length<6){notice('r-notice','Password minimal 6 karakter.','danger');return;}
  if(pass!==pass2){notice('r-notice','Password tidak cocok.','danger');return;}
  if(!/^\d{9,15}$/.test(wa.replace(/\D/g,''))){notice('r-notice','Nomor WA tidak valid.','danger');return;}

  const users = DB.users;
  if(users.find(u=>u.polisi===polisi)){notice('r-notice','No. polisi sudah terdaftar.','danger');return;}

  const target = calcTarget(pajak);
  const weeks = weeksUntil(tempo);
  const perWeek = Math.ceil(target/weeks/100)*100;
  const hash = await sha256(pass);

  pendingRegData = {id:Date.now(), nama, wa, polisi, passHash:hash, pajakLalu:pajak, target, tempo, saldo:0, terdaftar:new Date().toLocaleDateString('id-ID')};

  document.getElementById('popup-title').innerHTML = `<i class="ti ti-calculator" aria-hidden="true"></i> Simulasi Tabungan Pajak`;
  document.getElementById('popup-content').innerHTML = `
    <div class="sim-row"><span class="sim-label">Nama</span><span class="sim-val">${nama}</span></div>
    <div class="sim-row"><span class="sim-label">No. Polisi</span><span class="sim-val">${polisi}</span></div>
    <div class="sim-row"><span class="sim-label">Pajak tahun lalu</span><span class="sim-val">${fmt(pajak)}</span></div>
    <div class="sim-row"><span class="sim-label">Biaya layanan (7%)</span><span class="sim-val">${fmt(pajak*0.07)}</span></div>
    <div class="sim-row"><span class="sim-label">Target tabungan</span><span class="highlight">${fmt(target)}</span></div>
    <div class="sim-row"><span class="sim-label">Jatuh tempo</span><span class="sim-val">${new Date(tempo).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})}</span></div>
    <div class="sim-row"><span class="sim-label">Sisa waktu</span><span class="sim-val">${weeks} minggu</span></div>
    <div class="sim-row"><span class="sim-label">Estimasi setoran/minggu</span><span class="sim-val" style="color:#1d4ed8">${fmt(perWeek)}</span></div>
  `;
  
  document.getElementById('popup-actions').innerHTML = `
    <button class="btn" onclick="closePopup()" style="flex:1">Tutup</button>
    <button class="btn btn-primary" onclick="confirmRegister()" style="flex:1">Daftar Sekarang</button>
  `;
  document.getElementById('popup').classList.add('open');
  notice('r-notice','','');
}

function closePopup(){ 
  document.getElementById('popup').classList.remove('open'); 
  pendingRegData = null;
  pendingSetorData = null;
}

async function confirmRegister(){
  if(!pendingRegData) return;
  const users = DB.users;
  users.push(pendingRegData);
  DB.users = users;
  closePopup();
  notice('r-notice','Pendaftaran berhasil! Silakan gunakan menu Setor untuk mulai menabung.','success');
  ['r-nama','r-wa','r-polisi','r-pass','r-pass2','r-pajak','r-tempo'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('sim-preview').style.display='none';
}

function showPhoto(input){
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    const img = document.getElementById('foto-preview');
    img.src = e.target.result;
    img.style.display='block';
  };
  reader.readAsDataURL(file);
}

// FUNGSI BARU: Validasi input dan menampilkan rincian setoran + QR Code
async function checkAndPreviewSetor(){
  const polisi = document.getElementById('s-polisi').value.trim().toUpperCase();
  const nominal = parseFloat(document.getElementById('s-nominal').value)||0;
  const foto = document.getElementById('s-foto').files[0];

  if(!polisi||!nominal){notice('s-notice','Isi No. Polisi dan Nominal Setoran.','danger');return;}
  if(nominal<1000){notice('s-notice','Nominal minimal Rp 1.000.','danger');return;}

  const users = DB.users;
  const user = users.find(u=>u.polisi===polisi);
  if(!user){notice('s-notice','No. polisi tidak ditemukan. Pastikan sudah terdaftar.','danger');return;}

  let fotoData = null;
  if(foto){
    fotoData = await new Promise(r=>{const fr=new FileReader();fr.onload=e=>r(e.target.result);fr.readAsDataURL(foto);});
  }

  // Menyimpan data setoran sementara
  pendingSetorData = {
    id: Date.now(),
    polisi,
    nama: user.nama,
    wa: user.wa,
    nominal,
    foto: fotoData,
    tanggal: new Date().toLocaleDateString('id-ID'),
    confirmed: false
  };

  // Generate URL QR Code Statis berdasarkan nominal (Menggunakan QR-Server API)
  const qrData = `CelenganPajak-${polisi}-${nominal}`;
  const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(qrData)}`;

  // Menampilkan Konten di Popup
  document.getElementById('popup-title').innerHTML = `<i class="ti ti-cash" aria-hidden="true"></i> Rincian & Pembayaran Setoran`;
  document.getElementById('popup-content').innerHTML = `
    <div class="sim-row"><span class="sim-label">No. Polisi</span><span class="sim-val" style="font-weight:700">${polisi}</span></div>
    <div class="sim-row"><span class="sim-label">Nama Pengguna</span><span class="sim-val">${user.nama}</span></div>
    <div class="sim-row"><span class="sim-label">Jumlah Setoran</span><span class="highlight" style="color:#16a34a">${fmt(nominal)}</span></div>
    <div class="sim-row"><span class="sim-label">Tanggal Sesi</span><span class="sim-val">${pendingSetorData.tanggal}</span></div>
    <div class="sim-row"><span class="sim-label">Lampiran Bukti</span><span class="sim-val">${foto ? '✅ Tersedia' : '❌ Belum diunggah'}</span></div>
    
    <div class="qr-container">
      <div style="font-size:12px; font-weight:600; margin-bottom:4px; color:#374151">Pindai QR Code untuk Transfer:</div>
      <img src="${qrUrl}" alt="QR Pembayaran" class="qr-image">
      <div style="font-size:11px; color:#6b7280; margin-top:4px">Silakan transfer sesuai nominal di atas</div>
    </div>
  `;

  document.getElementById('popup-actions').innerHTML = `
    <button class="btn" onclick="closePopup()" style="flex:1">Batal</button>
    <button class="btn btn-success" onclick="confirmSetor()" style="flex:1">Konfirmasi Selesai</button>
  `;

  document.getElementById('popup').classList.add('open');
  notice('s-notice','','');
}

// FUNGSI BARU: Eksekusi penyimpanan data setoran setelah konfirmasi dari popup resmi ditekan
function confirmSetor(){
  if(!pendingSetorData) return;
  
  const setoran = DB.setoran;
  setoran.push(pendingSetorData);
  DB.setoran = setoran;

  // Reset form setor
  document.getElementById('s-polisi').value='';
  document.getElementById('s-nominal').value='';
  document.getElementById('s-foto').value='';
  document.getElementById('foto-preview').style.display='none';
  
  // Tutup popup
  document.getElementById('popup').classList.remove('open');
  
  notice('s-notice','Setoran berhasil dikirim! Saldo akan bertambah setelah dikonfirmasi oleh admin. Silakan cek saldo secara berkala.','success');
  pendingSetorData = null;
}

async function doLogin(){
  const polisi = document.getElementById('cs-polisi').value.trim().toUpperCase();
  const pass = document.getElementById('cs-pass').value;
  if(!polisi||!pass){notice('cs-notice','Isi No. Polisi dan Password.','danger');return;}
  const hash = await sha256(pass);
  const user = DB.users.find(u=>u.polisi===polisi && u.passHash===hash);
  if(!user){notice('cs-notice','No. Polisi atau Password salah.','danger');return;}
  renderSaldo(user);
}

function getSaldo(polisi){
  return DB.setoran.filter(s=>s.polisi===polisi&&s.confirmed).reduce((a,s)=>a+s.nominal,0);
}

function renderSaldo(user){
  const saldo = getSaldo(user.polisi);
  const pct = Math.min(100, Math.round(saldo/user.target*100));
  document.getElementById('sr-nama').textContent = user.nama;
  document.getElementById('sr-polisi').textContent = user.polisi;
  document.getElementById('sr-saldo').textContent = fmt(saldo);
  document.getElementById('sr-target').textContent = fmt(user.target);
  document.getElementById('sr-target').style.color = saldo>=user.target?'#16a34a':'#dc2626';
  document.getElementById('sr-bar').style.width = pct+'%';
  document.getElementById('sr-bar').className = 'prog-fill'+(saldo>=user.target?' done':'');
  document.getElementById('sr-pct').textContent = pct+'% tercapai';
  document.getElementById('sr-tempo').textContent = new Date(user.tempo).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});

  const klaimBtn = document.getElementById('klaim-btn');
  const sudahKlaim = DB.klaim.find(k=>k.polisi===user.polisi&&k.status==='pending');
  if(sudahKlaim){ klaimBtn.disabled=true; klaimBtn.textContent='Klaim sudah diajukan'; }
  else if(saldo>=user.target){ klaimBtn.disabled=false; klaimBtn.textContent='Klaim Tabungan'; klaimBtn.onclick=()=>doKlaim(user.polisi); }
  else { klaimBtn.disabled=true; klaimBtn.textContent='Klaim (belum mencapai target)'; }

  const setoran = DB.setoran.filter(s=>s.polisi===user.polisi);
  const tbl = setoran.length===0
    ? '<div style="color:#6b7280;font-size:13px;padding:8px 0">Belum ada setoran.</div>'
    : `<table class="tbl"><thead><tr><th>Tanggal</th><th>Nominal</th><th>Status</th></tr></thead><tbody>
      ${setoran.map(s=>`<tr><td>${s.tanggal}</td><td>${fmt(s.nominal)}</td><td><span class="badge ${s.confirmed?'badge-success':'badge-warn'}">${s.confirmed?'Terkonfirmasi':'Menunggu'}</span></td></tr>`).join('')}
      </tbody></table>`;
  document.getElementById('sr-tbl-wrap').innerHTML = tbl;

  document.getElementById('saldo-login-card').style.display='none';
  document.getElementById('saldo-result').style.display='block';
  notice('cs-notice','','');
}

function doKlaim(polisi){
  const users = DB.users;
  const user = users.find(u=>u.polisi===polisi);
  if(!user) return;
  const saldo = getSaldo(polisi);
  const klaim = DB.klaim;
  klaim.push({id:Date.now(), polisi, nama:user.nama, wa:user.wa, saldo, tanggal:new Date().toLocaleDateString('id-ID'), status:'pending'});
  DB.klaim = klaim;
  notice('klaim-notice','Permintaan klaim berhasil dikirim! Admin akan segera memproses.','success');
  document.getElementById('klaim-btn').disabled=true;
  document.getElementById('klaim-btn').textContent='Klaim sudah diajukan';
}

function logoutSaldo(){
  document.getElementById('saldo-result').style.display='none';
  document.getElementById('saldo-login-card').style.display='block';
  document.getElementById('cs-polisi').value='';
  document.getElementById('cs-pass').value='';
}

function doAdminLogin(){
  const pass = document.getElementById('a-pass').value;
  if(pass==='380celenganpajak'){
    document.getElementById('admin-login-card').style.display='none';
    document.getElementById('admin-panel').style.display='block';
    renderAdminUsers();
  } else {
    notice('a-notice','Password salah.','danger');
  }
}

function doAdminLogout(){
  document.getElementById('admin-login-card').style.display='block';
  document.getElementById('admin-panel').style.display='none';
  document.getElementById('a-pass').value='';
}

function renderAdminUsers(){
  const users = DB.users;
  const el = document.getElementById('admin-user-tbl');
  if(!users.length){el.innerHTML='<div style="color:#6b7280;font-size:13px;padding:8px 0">Belum ada pengguna terdaftar.</div>';return;}
  el.innerHTML=`<div style="overflow-x:auto"><table class="tbl" style="table-layout:fixed;min-width:500px">
    <thead><tr><th style="width:130px">Nama</th><th style="width:90px">No. Polisi</th><th style="width:100px">No. WA</th><th style="width:90px">Target</th><th style="width:90px">Saldo</th><th style="width:70px">Status</th></tr></thead>
    <tbody>
    ${users.map(u=>{
      const saldo=getSaldo(u.polisi);
      const lunas=saldo>=u.target;
      return `<tr>
        <td class="${lunas?'green-name':''}">${u.nama}</td>
        <td>${u.polisi}</td>
        <td>${u.wa}</td>
        <td style="font-size:11px">${fmt(u.target)}</td>
        <td style="font-size:11px;color:#1d4ed8">${fmt(saldo)}</td>
        <td><span class="badge ${lunas?'badge-success':'badge-warn'}">${lunas?'Lunas':'Proses'}</span></td>
      </tr>`;
    }).join('')}
    </tbody></table></div>`;
}

function renderAdminSetor(){
  const setoran = DB.setoran.filter(s=>!s.confirmed);
  const el = document.getElementById('admin-setor-tbl');
  if(!setoran.length){el.innerHTML='<div style="color:#6b7280;font-size:13px;padding:8px 0">Tidak ada setoran yang menunggu konfirmasi.</div>';return;}
  el.innerHTML=`<div style="overflow-x:auto"><table class="tbl" style="table-layout:fixed;min-width:480px">
    <thead><tr><th style="width:90px">No. Polisi</th><th style="width:80px">No. WA</th><th style="width:80px">Nominal</th><th style="width:70px">Tanggal</th><th style="width:50px">Bukti</th><th style="width:50px">Aksi</th></tr></thead>
    <tbody>
    ${setoran.map(s=>`<tr>
      <td>${s.polisi}</td>
      <td style="font-size:11px">${s.wa}</td>
      <td style="font-size:11px">${fmt(s.nominal)}</td>
      <td style="font-size:11px">${s.tanggal}</td>
      <td>${s.foto?`<img src="${s.foto}" style="width:36px;height:36px;object-fit:cover;border-radius:4px;cursor:pointer" onclick="showFotoFull('${s.foto}')">`:'-'}</td>
      <td><button class="check-btn" title="Konfirmasi setoran" onclick="konfirmasiSetor(${s.id})"><i class="ti ti-check" aria-hidden="true"></i></button></td>
    </tr>`).join('')}
    </tbody></table></div>`;
}

function showFotoFull(src){
  const w=window.open('','_blank','width=600,height=600');
  w.document.write(`<img src="${src}" style="max-width:100%;max-height:100%">`);
}

function konfirmasiSetor(id){
  const setoran = DB.setoran;
  const idx = setoran.findIndex(s=>s.id===id);
  if(idx<0) return;
  setoran[idx].confirmed=true;
  DB.setoran=setoran;
  renderAdminSetor();
  renderAdminUsers();
}

function renderAdminKlaim(){
  const klaims = DB.klaim.filter(k=>k.status==='pending');
  const el = document.getElementById('admin-klaim-tbl');
  if(!klaims.length){el.innerHTML='<div style="color:#6b7280;font-size:13px;padding:8px 0">Tidak ada permintaan klaim saat ini.</div>';return;}
  el.innerHTML=`<div style="overflow-x:auto"><table class="tbl" style="table-layout:fixed;min-width:450px">
    <thead><tr><th style="width:110px">Nama</th><th style="width:90px">No. Polisi</th><th style="width:90px">No. WA</th><th style="width:90px">Nominal Klaim</th><th style="width:70px">Tanggal</th><th style="width:50px">Selesai</th></tr></thead>
    <tbody>
    ${klaims.map(k=>`<tr>
      <td>${k.nama}</td>
      <td>${k.polisi}</td>
      <td style="font-size:11px">${k.wa}</td>
      <td style="font-size:11px;color:#16a34a">${fmt(k.saldo)}</td>
      <td style="font-size:11px">${k.tanggal}</td>
      <td><button class="check-btn" title="Tandai selesai" onclick="selesaikanKlaim(${k.id})"><i class="ti ti-check" aria-hidden="true"></i></button></td>
    </tr>`).join('')}
    </tbody></table></div>`;
}

function selesaikanKlaim(id){
  const klaims = DB.klaim;
  const idx = klaims.findIndex(k=>k.id===id);
  if(idx<0) return;
  klaims[idx].status='selesai';
  DB.klaim=klaims;
  renderAdminKlaim();
}
</script>

</body>
