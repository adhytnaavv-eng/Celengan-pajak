<div id="pg-admin" class="page">
  <div id="admin-login-card" class="card">
    <div class="card-title"><i class="ti ti-shield" aria-hidden="true"></i> Login Admin</div>
    <div class="field"><label>Password Admin</label><input id="a-pass" type="password" placeholder="Masukkan password admin" onkeydown="if(event.key==='Enter')doAdminLogin()"></div>
    <div id="a-notice"></div>
