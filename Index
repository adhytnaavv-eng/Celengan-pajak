    <div class="sect-tabs">
      <button class="sect-tab active" onclick="showAdminSect('data-user')">Data User</button>
      <button class="sect-tab" onclick="showAdminSect('konfirmasi-setor')">Konfirmasi Setoran</button>
      <button class="sect-tab" onclick="showAdminSect('konfirmasi-klaim')">Konfirmasi Klaim</button>
    </div>

    <div id="ad-data-user" class="admin-section active">
      <div class="card">
        <div class="card-title"><i class="ti ti-users" aria-hidden="true"></i> Data Pengguna Terdaftar</div>
        <div id="admin-user-tbl"></div>
      </div>
    </div>

    <div id="ad-konfirmasi-setor" class="admin-section">
      <div class="card">
        <div class="card-title"><i class="ti ti-check" aria-hidden="true"></i> Antrian Konfirmasi Setoran</div>
        <div id="admin-setor-tbl"></div>
      </div>
    </div>

    <div id="ad-konfirmasi-klaim" class="admin-section">
      <div class="card">
        <div class="card-title"><i class="ti ti-gift" aria-hidden="true"></i> Permintaan Klaim</div>
        <div id="admin-klaim-tbl"></div>
